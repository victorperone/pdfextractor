# OCR, layout and table model caches or weights
models/**
model-cache/**
.model-cache/**
.paddleocr/**
paddleocr_cache/**
PaddleOCR/inference_results/**
inference_results/**
*.onnx
*.pdmodel
*.pdiparams
*.pdiparams.info
*.nb
*.pt
*.pth
*.ckpt
*.safetensors
*.bin

# ML or experiment trackers, should not contain document text in git
mlruns/
wandb/
runs/

# Jupyter local state
.ipynb_checkpoints/
notebooks/.ipynb_checkpoints/
notebooks/output/
notebooks/tmp/